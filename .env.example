# Server only. Never use a VITE_ prefix. Keep real credentials out of Git.
DASHSCOPE_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-plus
# Set true only after explicitly agreeing to paid Qwen requests.
QWEN_ENABLE_PAID_REQUESTS=false
QWEN_TIMEOUT_MS=60000
QWEN_HISTORY_MESSAGES=20
QWEN_HISTORY_CHARS=12000
QWEN_HISTORY_POLICY=window
# Explicit owner opt-in. Never enable on the official public Demo deployment.
# When true, this private configuration is sent to your configured Qwen provider as prompt data.
CHARACTER_CUSTOM_ENABLED=false
